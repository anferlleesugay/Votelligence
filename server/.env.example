# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Port the Express API listens on
PORT=3000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=votelligence_db

# Online databases (Aiven) need an encrypted connection: set DB_SSL=true.
# Optional: paste Aiven's CA certificate into DB_CA_CERT to also verify the server.
DB_SSL=false
DB_CA_CERT=

# Frontend URL(s) allowed by CORS (comma-separated if more than one)
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign login tokens (JWT). Use any long random string.
JWT_SECRET=c7f38042130ec9996918564037cbe10dc4e233e132ba16e5a0a9ebc710e86927

# Google Gemini (AI features). Get a key at https://aistudio.google.com/apikey
# The app still works without a key; only the AI buttons will show an error.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
